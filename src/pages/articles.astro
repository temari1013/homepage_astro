---
import type { MarkdownInstance } from 'astro'
import BaseLayout from '../layouts/BaseLayout.astro'
const pagetitle = '記事一覧'
const importedPosts = import.meta.glob('../pages/posts/*.md', { eager: true })
const allPosts = Object.values(importedPosts).reverse() as MarkdownInstance<Record<string, any>>[]
function parseDate(str: string) {
  return parseInt(str.replace(/-/g, ''), 10)
}

const sortedPosts = allPosts.sort((a, b) => {
  const dateA = parseDate(a.frontmatter.pubDate)
  const dateB = parseDate(b.frontmatter.pubDate)
  return dateB - dateA
})
---

<BaseLayout pageTitle={pagetitle}>
  <section class="py-4 text-slate-900">
    <div class="mb-6 border-b border-slate-200 pb-3">
      <p class="text-sm font-semibold tracking-wide text-[#FF7043]">All Posts</p>
      <h2 class="mt-1 text-2xl font-bold text-slate-800">記事一覧</h2>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {
        sortedPosts.map((post) => {
          const image = post.frontmatter.image
          const imageUrl = image?.url ?? '/thumbnail.png'
          const imageAlt = image?.alt ?? post.frontmatter.title

          return (
            <a
              href={post.url}
              class="group block overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-[#FF7043] hover:shadow-lg"
            >
              <article>
                <div class="aspect-[16/9]">
                  <img
                    src={imageUrl}
                    alt={imageAlt}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="flex min-h-32 flex-col justify-between p-4">
                  <div>
                    <p class="text-sm font-semibold text-slate-500">{post.frontmatter.pubDate}</p>
                    <h3 class="mt-1 text-lg font-bold leading-snug text-slate-800 group-hover:text-[#FF7043]">
                      {post.frontmatter.title}
                    </h3>
                    {post.frontmatter.description && (
                      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{post.frontmatter.description}</p>
                    )}
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {post.frontmatter.tags?.slice(0, 4).map((tag: string) => (
                      <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">{tag}</span>
                    ))}
                  </div>
                </div>
              </article>
            </a>
          )
        })
      }
    </div>
  </section>
</BaseLayout>
<meta charset="UTF-8" />
